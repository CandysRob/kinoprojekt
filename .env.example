# Kopeeri see fail nimega .env ja muuda väärtused.
# .env on .gitignore'is ja seda reposse ei panda.

# Uue võtme saad käsuga:
# uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=muuda-mind
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=kinoprojekt
POSTGRES_USER=kinoprojekt
POSTGRES_PASSWORD=muuda-mind
# localhost, kui Django töötab arvutis; Dockeris kasutab backend teenust "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Pordid, mille kaudu teenused arvutis avanevad (docker compose)
BACKEND_PORT=8000
FRONTEND_PORT=5173
