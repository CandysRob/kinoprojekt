<mxfile host="app.diagrams.net" agent="kinoprojekt" version="24.7.17">
  <diagram id="kino-flowchart" name="Filmi ja seansi leidmine">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Kinoprojekt: filmi leidmine ja selle seansside vaatamine" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="10" width="500" height="40" as="geometry" />
        </mxCell>

        <mxCell id="start" value="Algus:&lt;br&gt;kasutaja avab kino avalehe" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="loadMovies" value="Süsteem laeb filmide nimekirja&lt;br&gt;&lt;i&gt;GET /api/movies/&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="170" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="decLoaded" value="Kas filmide laadimine õnnestus?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="280" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="showError" value="Näidatakse veateadet ja nuppu „Proovi uuesti”.&lt;br&gt;Kasutaja vajutab nuppu." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="305" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="decDate" value="Kas kasutaja valib seansi kuupäeva?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="440" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="showAll" value="Näidatakse kõiki filme" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="20" y="465" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="filterDate" value="Süsteem otsib filmid, millel on sel päeval seanss&lt;br&gt;&lt;i&gt;GET /api/movies/?date=…&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="600" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="decHasFilms" value="Kas sel päeval on filme?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="720" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="noFilms" value="Näidatakse teadet „Seansse pole. Vali teine kuupäev.”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="745" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="clickFilm" value="Kasutaja valib filmi ja klõpsab selle kaardil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="880" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="loadDetail" value="Avaneb filmi leht. Süsteem laeb filmi andmed ja tulevased seansid&lt;br&gt;&lt;i&gt;GET /api/movies/{id}/&lt;br&gt;GET /api/screenings/?movie={id}&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="990" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="decScreenings" value="Kas filmil on tulevasi seansse?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="250" y="1130" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="noScreenings" value="Näidatakse teadet „Sellel filmil pole praegu seansse.”" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="1155" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="showTable" value="Näidatakse seansside tabelit: kuupäev, kell, kino, saal ja hind" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="1290" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="end" value="Lõpp:&lt;br&gt;kasutaja on filmi andmed ja seansid üle vaadanud" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="1400" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Märkus&lt;/b&gt;&lt;br&gt;Piletite broneerimine, istekoha valik ja maksmine on alles planeeritud. Andmebaasis on tabelid olemas, aga API ja leht puuduvad. Filmi lehel on kiri „Piletite broneerimine pole veel valmis.”, seepärast neid samme diagrammis pole." style="shape=note;whiteSpace=wrap;html=1;size=14;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="10" y="1130" width="210" height="170" as="geometry" />
        </mxCell>

